---
const items = [
  { icon: '☁️', title: '100% en la nube', desc: 'Accede desde cualquier lugar' },
  { icon: '📄', title: 'Facturación electrónica', desc: 'Cumple con SUNAT fácil' },
  { icon: '📊', title: 'Reportes en tiempo real', desc: 'Decisiones con datos' },
  { icon: '🛡️', title: 'Seguro y confiable', desc: 'Tu información protegida' },
  { icon: '🎧', title: 'Soporte local', desc: 'Equipo peruano 24/7' },
];
---

<div class="py-6 border-t border-b border-border bg-white">
  <div class="max-w-[1180px] mx-auto px-6 flex flex-wrap justify-center gap-9" data-animate="stagger" data-stagger-target=".trust-bar-item">
    {items.map((item) => (
      <div class="trust-bar-item flex items-center gap-2.5">
        <div class="w-9 h-9 bg-primary-light rounded-lg flex items-center justify-center text-base shrink-0">{item.icon}</div>
        <div>
          <strong class="text-[0.85rem] font-bold block text-dark2">{item.title}</strong>
          <span class="text-xs text-gray font-normal">{item.desc}</span>
        </div>
      </div>
    ))}
  </div>
</div>