---
const perks = [
  { icon: '🎓', text: 'Demo gratuita de 30 min' },
  { icon: '⚡', text: 'Implementación en 48h' },
  { icon: '🛡️', text: '15 días de prueba gratis' },
];
---

<section class="bg-[linear-gradient(145deg,#007A3D_0%,#00A650_50%,#00C060_100%)] py-[76px]" id="demo">
  <div class="max-w-[1180px] mx-auto px-6">
    <span class="block text-center text-xs font-bold tracking-[0.14em] uppercase text-white/65 mb-2" data-animate="fade-up">Sin compromiso · Prueba gratis 15 días</span>
    <h2 class="text-center font-bold text-[clamp(1.7rem,3.2vw,2.4rem)] leading-tight mb- text-white" data-animate="fade-up">Empieza a transformar<br>tu negocio hoy</h2>
    <p class="text-center text-white/80 text-base max-w-[580px] mx-auto mb-10 leading-relaxed" data-animate="fade-up">Demo gratuita de 30 minutos. Implementación en 48 horas.</p>

    <div class="flex flex-wrap justify-center gap-5 mb-10" data-animate="stagger" data-stagger-target=".demo-perk">
      {perks.map((p) => (
        <div class="demo-perk flex items-center gap-2 text-white text-[0.88rem] font-semibold bg-white/12 px-[18px] py-2.5 rounded-full border border-white/20">
          <span class="text-xl">{p.icon}</span> {p.text}
        </div>
      ))}
    </div>

    <form class="flex flex-wrap gap-3 justify-center max-w-[580px] mx-auto" data-animate="stagger" data-stagger-target=".demo-input" onsubmit="return false;">
      <input type="text" placeholder="Tu nombre" required autocomplete="name"
        class="demo-input flex-1 min-w-[160px] px-[18px] py-[13px] rounded-lg bg-white/15 text-white text-[0.9rem] font-medium outline-none border border-white/25 placeholder-white/60 focus:bg-white/22 focus:border-white/50" />
      <input type="text" placeholder="Nombre de tu negocio" autocomplete="organization"
        class="demo-input flex-1 min-w-[160px] px-[18px] py-[13px] rounded-lg bg-white/15 text-white text-[0.9rem] font-medium outline-none border border-white/25 placeholder-white/60 focus:bg-white/22 focus:border-white/50" />
      <input type="tel" placeholder="WhatsApp" required autocomplete="tel"
        class="demo-input flex-1 min-w-[160px] px-[18px] py-[13px] rounded-lg bg-white/15 text-white text-[0.9rem] font-medium outline-none border border-white/25 placeholder-white/60 focus:bg-white/22 focus:border-white/50" />
      <input type="email" placeholder="Correo electrónico" autocomplete="email"
        class="demo-input flex-1 min-w-[160px] px-[18px] py-[13px] rounded-lg bg-white/15 text-white text-[0.9rem] font-medium outline-none border border-white/25 placeholder-white/60 focus:bg-white/22 focus:border-white/50" />
    </form>
    <div class="text-center mt-3.5" data-animate="fade-up">
      <button data-magnetic="0.2" class="w-full max-w-[580px] block mx-auto bg-yellow text-dark2 font-bold rounded-lg px-8 py-[15px] text-base font-sans cursor-pointer transition-all duration-200 hover:bg-yellow-dark hover:shadow-[0_8px_20px_rgba(255,242,0,0.3)]">
        Solicitar Demo Gratuita →
      </button>
    </div>
    <p class="text-center text-white/70 text-[0.82rem] mt-3.5 font-medium" data-animate="fade-up">🏆 Garantía de satisfacción o te devolvemos tu dinero</p>

    <div class="text-center mt-5" data-animate="fade-up">
      <a href="https://wa.me/51XXXXXXXXX" data-magnetic="0.3" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-lg border-2 border-white/35 text-white font-semibold transition-all duration-200 hover:bg-white/12 hover:border-white/60 no-underline" target="_blank">
        <svg viewBox="0 0 24 24" class="w-[17px] h-[17px] fill-white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
        Hablar por WhatsApp
      </a>
    </div>
  </div>
</section>