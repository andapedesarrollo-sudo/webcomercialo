---
import { solutions } from "../data/solutions";
const features = [
  "Facturación electrónica",
  "POS rápido",
  "Inventario",
  "Dashboard gerencial",
];
const company = [
  { label: "Casos de éxito", href: "/casos-de-exito", external: false },
  { label: "Blog", href: "/blog", external: false },
  {
    label: "Términos de servicio",
    href: "/Terminos-y-Condiciones",
    external: true,
  },
  {
    label: "Libro de Reclamaciones",
    href: "https://app.reclamolegal.pe/form-reclamacion/gen-ai-legal-sacs",
    external: true,
  },
];
---

<footer class="bg-dark2 text-white pt-12 pb-6">
  <div
    class="max-w-[1180px] mx-auto px-6 flex flex-wrap justify-between gap-8"
    data-animate="stagger"
    data-stagger-target=".footer-col"
  >
    <div class="footer-col">
      <div
        class="flex items-center gap-2 text-[1.35rem] font-extrabold text-green-400 mb-1"
      >
        <div
          class="w-6 h-6 bg-primary rounded-[5px] flex items-center justify-center"
        >
          <svg viewBox="0 0 20 20" class="w-[13px] h-[13px] fill-white"
            ><path
              d="M10 2C5.58 2 2 5.58 2 10s3.58 8 8 8 8-3.58 8-8-3.58-8-8-8zm3.7 6.3l-4 4c-.2.2-.45.3-.7.3s-.5-.1-.7-.3l-2-2c-.4-.4-.4-1 0-1.4.4-.4 1-.4 1.4 0l1.3 1.3 3.3-3.3c.4-.4 1-.4 1.4 0 .4.4.4 1 0 1.4z"
            ></path></svg
          >
        </div>
        Comercialo
      </div>
      <div class="text-[0.62rem] font-medium text-white/40 mb-2.5">
        Sistema de facturación y gestión para negocios que quieren crecer
      </div>
      <p class="text-white/50 text-[0.82rem] leading-relaxed">
        Cumplimiento SUNAT garantizado.<br />Tu negocio, en control total.
      </p>
    </div>

    <div class="footer-col">
      <h4
        class="text-[0.75rem] font-bold uppercase tracking-[0.1em] text-white/40 mb-3"
      >
        Soluciones
      </h4>
      {
        solutions.map((s) => (
          <a
            href={`/soluciones/${s.slug}`}
            class="block text-white/70 text-[0.85rem] mb-2 transition-colors duration-150 hover:text-green-400 no-underline"
          >
            {s.title}
          </a>
        ))
      }
    </div>

    <div class="footer-col">
      <h4
        class="text-[0.75rem] font-bold uppercase tracking-[0.1em] text-white/40 mb-3"
      >
        Funciones
      </h4>
      {
        features.map((f) => (
          <a
            href="#"
            class="block text-white/70 text-[0.85rem] mb-2 transition-colors duration-150 hover:text-green-400 no-underline"
          >
            {f}
          </a>
        ))
      }
    </div>

    <div class="footer-col">
      <h4
        class="text-[0.75rem] font-bold uppercase tracking-[0.1em] text-white/40 mb-3"
      >
        Empresa
      </h4>
      {
        company.map((c) => (
          <a
            href={c.href}
            target={c.external ? "_blank" : "_self"}
            rel={c.external ? "noopener noreferrer" : undefined}
            class="block text-white/70 text-[0.85rem] mb-2 transition-colors duration-150 hover:text-green-400 no-underline"
          >
            {c.label}
          </a>
        ))
      }
    </div>
  </div>

  <div
    class="max-w-[1180px] mx-auto px-6 border-t border-white/7 mt-8 pt-5 text-white/35 text-xs flex justify-between flex-wrap gap-2"
  >
    <span>&copy; 2025 Comercialo · Todos los derechos reservados.</span>
    <span>Cumplimiento SUNAT · 100% en la nube · Lima, Perú</span>
  </div>
</footer>
