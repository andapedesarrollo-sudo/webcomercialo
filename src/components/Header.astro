---
const links = [
  { href: '#soluciones', label: 'Soluciones' },
  { href: '#modulos', label: 'Funciones' },
  { href: '#precios', label: 'Precios' },
  { href: '#casos', label: 'Casos de éxito' },
];
---

<header data-animate="header-shrink" class="sticky top-0 z-100 bg-white border-b border-border transition-all duration-300">
  <div class="max-w-[1180px] mx-auto px-6 flex justify-between items-center h-[68px] gap-4">
    <a href="/" class="flex flex-col gap-0 no-underline">
      <div class="flex items-center gap-1.5 font-extrabold text-2xl text-primary leading-none">
        <div class="w-7 h-7 bg-primary rounded-md flex items-center justify-center shrink-0">
          <svg viewBox="0 0 20 20" class="w-4 h-4 fill-white"><path d="M10 2C5.58 2 2 5.58 2 10s3.58 8 8 8 8-3.58 8-8-3.58-8-8-8zm3.7 6.3l-4 4c-.2.2-.45.3-.7.3s-.5-.1-.7-.3l-2-2c-.4-.4-.4-1 0-1.4.4-.4 1-.4 1.4 0l1.3 1.3 3.3-3.3c.4-.4 1-.4 1.4 0 .4.4.4 1 0 1.4z"/></svg>
        </div>
        Comercialo
      </div>
      <span class="text-[0.6rem] font-medium text-gray leading-tight mt-0.5">Sistema de facturación y gestión para negocios que quieren crecer</span>
    </a>

    <nav class="flex items-center gap-1">
      {links.map((link) => (
        <a href={link.href} class="text-dark font-medium text-sm px-3 py-2 rounded-md transition-all duration-150 hover:text-primary hover:bg-primary-light">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 ml-3">
      <a href="/login" class="text-sm font-semibold text-dark px-3.5 py-2 rounded-md border border-border transition-all duration-150 hover:border-primary hover:text-primary">
        Iniciar sesión
      </a>
      <a href="#demo" data-magnetic="0.3" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-primary text-white font-semibold text-sm min-h-[48px] shadow-[0_4px_14px_rgba(0,166,80,0.30)] transition-all duration-200 hover:bg-primary-dark hover:shadow-[0_8px_22px_rgba(0,166,80,0.40)]">
        Prueba gratis por 15 días
      </a>
    </div>
  </div>
</header>