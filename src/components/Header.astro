---
const links = [
  { href: '#soluciones', label: 'Soluciones' },
  { href: '#modulos', label: 'Funciones' },
  { href: '#precios', label: 'Precios' },
  { href: '#casos', label: 'Casos de éxito' },
];
---

<header data-animate="header-shrink" class="sticky top-0 z-100 bg-white border-b border-border transition-all duration-300">
  <div class="max-w-[1180px] mx-auto px-6 flex justify-between items-center h-[68px] gap-4 relative">
    <a href="/" class="flex flex-col gap-0 no-underline shrink-0">
      <div class="flex items-center gap-1.5 font-extrabold text-2xl text-primary leading-none">
        <div class="w-7 h-7 bg-primary rounded-md flex items-center justify-center shrink-0">
          <svg viewBox="0 0 20 20" class="w-4 h-4 fill-white"><path d="M10 2C5.58 2 2 5.58 2 10s3.58 8 8 8 8-3.58 8-8-3.58-8-8-8zm3.7 6.3l-4 4c-.2.2-.45.3-.7.3s-.5-.1-.7-.3l-2-2c-.4-.4-.4-1 0-1.4.4-.4 1-.4 1.4 0l1.3 1.3 3.3-3.3c.4-.4 1-.4 1.4 0 .4.4.4 1 0 1.4z"/></svg>
        </div>
        Comercialo
      </div>
      <span class="text-[0.6rem] font-medium text-gray leading-tight mt-0.5 max-w-[190px] sm:max-w-none truncate sm:whitespace-normal">
        Sistema de facturación y gestión para negocios que quieren crecer
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-1">
      {links.map((link) => (
        <a href={link.href} class="text-dark font-medium text-sm px-3 py-2 rounded-md transition-all duration-150 hover:text-primary hover:bg-primary-light">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-2 ml-3 shrink-0">
      <a href="/login" class="text-sm font-semibold text-dark px-3.5 py-2 rounded-md border border-border transition-all duration-150 hover:border-primary hover:text-primary">
        Iniciar sesión
      </a>
      <a href="#demo" data-magnetic="0.3" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-primary text-white font-semibold text-sm min-h-[48px] shadow-[0_4px_14px_rgba(0,166,80,0.30)] transition-all duration-200 hover:bg-primary-dark hover:shadow-[0_8px_22px_rgba(0,166,80,0.40)]">
        Prueba gratis por 15 días
      </a>
    </div>

    <!-- Hamburger menu toggle -->
    <button id="menu-toggle" aria-label="Toggle Menu" class="flex lg:hidden flex-col justify-center items-center w-8 h-8 rounded-md border border-border bg-white cursor-pointer hover:bg-light transition-colors shrink-0">
      <span class="w-4.5 h-0.5 bg-dark mb-1 transition-transform duration-200 origin-center" id="hamburger-1"></span>
      <span class="w-4.5 h-0.5 bg-dark mb-1 transition-opacity duration-200 origin-center" id="hamburger-2"></span>
      <span class="w-4.5 h-0.5 bg-dark transition-transform duration-200 origin-center" id="hamburger-3"></span>
    </button>
  </div>

  <!-- Mobile menu dropdown -->
  <div id="mobile-menu" class="hidden absolute top-[68px] left-0 w-full bg-white border-b border-border shadow-lg z-50 flex-col px-6 py-5 gap-4 lg:hidden">
    <div class="flex flex-col gap-1.5">
      {links.map((link) => (
        <a href={link.href} class="mobile-menu-link text-dark font-semibold text-base py-2.5 px-3 rounded-md transition-all duration-150 hover:text-primary hover:bg-primary-light">
          {link.label}
        </a>
      ))}
    </div>
    <hr class="border-border my-1" />
    <div class="flex flex-col gap-2.5">
      <a href="/login" class="mobile-menu-link text-center text-sm font-bold text-dark py-3.5 rounded-lg border border-border transition-all duration-150 hover:border-primary hover:text-primary">
        Iniciar sesión
      </a>
      <a href="#demo" class="mobile-menu-link text-center text-sm font-bold bg-primary text-white py-3.5 rounded-lg shadow-[0_4px_14px_rgba(0,166,80,0.20)]">
        Prueba gratis por 15 días
      </a>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggle = document.querySelector('#menu-toggle');
    const menu = document.querySelector('#mobile-menu');
    const links = document.querySelectorAll('.mobile-menu-link');
    const line1 = document.querySelector('#hamburger-1');
    const line2 = document.querySelector('#hamburger-2');
    const line3 = document.querySelector('#hamburger-3');

    if (!toggle || !menu) return;

    const toggleMenu = () => {
      const isOpen = menu.classList.contains('flex');
      if (isOpen) {
        menu.classList.remove('flex');
        menu.classList.add('hidden');
        line1?.classList.remove('rotate-45', 'translate-y-[6px]');
        line2?.classList.remove('opacity-0');
        line3?.classList.remove('-rotate-45', '-translate-y-[6px]');
      } else {
        menu.classList.remove('hidden');
        menu.classList.add('flex');
        line1?.classList.add('rotate-45', 'translate-y-[6px]');
        line2?.classList.add('opacity-0');
        line3?.classList.add('-rotate-45', '-translate-y-[6px]');
      }
    };

    // Remove old listeners by replacing the element or cloning it (clean slate)
    const newToggle = toggle.cloneNode(true);
    toggle.parentNode?.replaceChild(newToggle, toggle);

    newToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.remove('flex');
        menu.classList.add('hidden');
        line1?.classList.remove('rotate-45', 'translate-y-[6px]');
        line2?.classList.remove('opacity-0');
        line3?.classList.remove('-rotate-45', '-translate-y-[6px]');
      });
    });
  }

  // Handle global click outside once at module load
  document.addEventListener('click', (e) => {
    const menu = document.querySelector('#mobile-menu');
    const toggle = document.querySelector('#menu-toggle');
    const line1 = document.querySelector('#hamburger-1');
    const line2 = document.querySelector('#hamburger-2');
    const line3 = document.querySelector('#hamburger-3');

    if (menu && menu.classList.contains('flex') && 
        !menu.contains(e.target as Node) && 
        toggle && !toggle.contains(e.target as Node)) {
      menu.classList.remove('flex');
      menu.classList.add('hidden');
      line1?.classList.remove('rotate-45', 'translate-y-[6px]');
      line2?.classList.remove('opacity-0');
      line3?.classList.remove('-rotate-45', '-translate-y-[6px]');
    }
  });

  // Run on initial load and page transitions
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>