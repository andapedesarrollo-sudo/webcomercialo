---
---

<section class="py-[72px] pb-16 bg-[linear-gradient(155deg,#F0FAF4_0%,#FAFAFA_60%,#FFFEF0_100%)] overflow-hidden relative">
  <div class="absolute -top-[120px] -right-20 w-[480px] h-[480px] bg-[radial-gradient(circle,rgba(0,166,80,0.06)_0%,transparent_70%)] rounded-full" data-animate="parallax" data-parallax-speed="0.08"></div>
  <div class="max-w-[1180px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-[52px] items-center relative">
    <div>
      <div class="inline-flex items-center gap-2 bg-primary-light text-primary text-xs font-bold px-3.5 py-1.5 rounded-full mb-5 border border-primary/20" data-animate="fade-up">
        <span class="w-[7px] h-[7px] bg-primary rounded-full animate-pulse"></span>
        100% en la nube · Cumplimiento SUNAT garantizado
      </div>
      <h1 class="font-extrabold text-[clamp(2.2rem,5vw,3.4rem)] leading-tight tracking-tight mb-4 text-dark2" data-animate="fade-up">
        Tu negocio<br><em class="not-italic text-primary">en control total</em>
      </h1>
      <p class="text-lg text-gray max-w-[460px] leading-relaxed mb-7" data-animate="fade-up">
        Factura, vende, controla tu inventario y toma mejores decisiones — todo desde una sola plataforma diseñada para negocios que quieren crecer.
      </p>

      <div class="flex flex-wrap gap-2 mb-7" data-animate="stagger" data-stagger-target=".trust-chip">
        <div class="trust-chip flex items-center gap-1.5 bg-white border border-border px-3 py-1.5 rounded-full text-xs font-semibold text-dark">
          <span class="text-primary">✓</span> Fácil de usar
        </div>
        <div class="trust-chip flex items-center gap-1.5 bg-white border border-border px-3 py-1.5 rounded-full text-xs font-semibold text-dark">
          <span class="text-primary">✓</span> 100% en la nube
        </div>
        <div class="trust-chip flex items-center gap-1.5 bg-white border border-border px-3 py-1.5 rounded-full text-xs font-semibold text-dark">
          <span class="text-primary">✓</span> Facturación electrónica
        </div>
        <div class="trust-chip flex items-center gap-1.5 bg-white border border-border px-3 py-1.5 rounded-full text-xs font-semibold text-dark">
          <span class="text-primary">✓</span> Soporte local
        </div>
      </div>

      <div class="flex flex-wrap gap-3" data-animate="fade-up">
        <a href="#demo" data-magnetic="0.25" class="inline-flex items-center justify-center gap-2 px-[34px] py-4 rounded-lg bg-primary text-white font-semibold text-base min-h-[48px] shadow-[0_4px_14px_rgba(0,166,80,0.30)] transition-all duration-200 hover:bg-primary-dark hover:shadow-[0_8px_22px_rgba(0,166,80,0.40)]">
          Prueba gratis por 15 días
        </a>
        <a href="#demo" data-magnetic="0.2" class="inline-flex items-center justify-center gap-2 px-[34px] py-4 rounded-lg border-2 border-primary text-primary font-semibold text-base min-h-[48px] transition-all duration-200 hover:bg-primary hover:text-white">
          ▶ Ver cómo funciona
        </a>
      </div>
      <p class="text-xs text-gray mt-2.5 font-medium" data-animate="fade-up">🔒 Obtén tu prueba gratis por 15 días</p>
    </div>

    <div class="hidden lg:block relative" data-animate="parallax" data-parallax-speed="-0.06">
      <div data-tilt="8" class="bg-white rounded-2xl shadow-[0_20px_60px_rgba(0,166,80,0.12),0_0_0_1px_rgba(0,166,80,0.08)] overflow-hidden border border-border" style="transform-style: preserve-3d; will-change: transform;">
        <div class="bg-dark2 px-[18px] py-[11px] flex items-center gap-[7px]">
          <div class="w-[11px] h-[11px] rounded-full bg-[#FF5F57]"></div>
          <div class="w-[11px] h-[11px] rounded-full bg-[#FFBD2E]"></div>
          <div class="w-[11px] h-[11px] rounded-full bg-[#28C840]"></div>
          <div class="ml-3.5 flex items-center gap-2">
            <div class="w-[18px] h-[18px] bg-primary rounded-[4px] flex items-center justify-center">
              <svg viewBox="0 0 20 20" class="w-[10px] h-[10px] fill-white"><path d="M10 2C5.58 2 2 5.58 2 10s3.58 8 8 8 8-3.58 8-8-3.58-8-8-8zm3.7 6.3l-4 4c-.2.2-.45.3-.7.3s-.5-.1-.7-.3l-2-2c-.4-.4-.4-1 0-1.4.4-.4 1-.4 1.4 0l1.3 1.3 3.3-3.3c.4-.4 1-.4 1.4 0 .4.4.4 1 0 1.4z"/></svg>
            </div>
            <span class="text-xs font-extrabold text-white"><span class="text-green-400">C</span>omercialo</span>
          </div>
        </div>
        <div class="flex">
          <div class="bg-light w-[110px] p-3 shrink-0">
            <div class="text-[0.62rem] font-semibold text-gray px-2 py-[7px] rounded-md mb-[3px] bg-primary-light text-primary">🏠 Inicio</div>
            <div class="text-[0.62rem] font-semibold text-gray px-2 py-[7px] rounded-md mb-[3px]">📊 Ventas</div>
            <div class="text-[0.62rem] font-semibold text-gray px-2 py-[7px] rounded-md mb-[3px]">📦 Productos</div>
            <div class="text-[0.62rem] font-semibold text-gray px-2 py-[7px] rounded-md mb-[3px]">📋 Inventario</div>
            <div class="text-[0.62rem] font-semibold text-gray px-2 py-[7px] rounded-md mb-[3px]">🧾 Comprobantes</div>
            <div class="text-[0.62rem] font-semibold text-gray px-2 py-[7px] rounded-md mb-[3px]">📈 Reportes</div>
            <div class="text-[0.62rem] font-semibold text-gray px-2 py-[7px] rounded-md mb-[3px]">👤 Usuarios</div>
          </div>
          <div class="flex-1 p-[14px]">
            <div class="text-[0.8rem] font-bold text-dark2 mb-2.5">Resumen del día</div>
            <div class="grid grid-cols-3 gap-2 mb-2.5">
              <div class="bg-primary rounded-lg p-2.5">
                <div class="text-[0.55rem] font-semibold uppercase tracking-wider text-white/75 mb-1">Ventas del día</div>
                <div class="text-[1.05rem] font-extrabold text-white leading-none">S/ 2,450</div>
                <div class="text-[0.58rem] font-bold text-green-200 mt-1">+12.5% vs ayer</div>
              </div>
              <div class="bg-light rounded-lg p-2.5">
                <div class="text-[0.55rem] font-semibold uppercase tracking-wider text-gray mb-1">Comprobantes</div>
                <div class="text-[1.05rem] font-extrabold text-dark2 leading-none">28</div>
                <div class="text-[0.58rem] font-bold text-primary mt-1">+8.2% vs ayer</div>
              </div>
              <div class="bg-light rounded-lg p-2.5">
                <div class="text-[0.55rem] font-semibold uppercase tracking-wider text-gray mb-1">Ticket promedio</div>
                <div class="text-[1.05rem] font-extrabold text-dark2 leading-none">S/87.50</div>
                <div class="text-[0.58rem] font-bold text-primary mt-1">+5.7% vs ayer</div>
              </div>
            </div>
            <div class="bg-light rounded-lg p-2.5 mb-2.5">
              <div class="text-[0.58rem] font-bold text-gray uppercase tracking-wider mb-2">Ventas esta semana</div>
              <div class="flex items-end gap-[5px] h-12">
                <div class="flex-1 rounded-t-sm bg-border h-[32%]"></div>
                <div class="flex-1 rounded-t-sm bg-primary/35 h-[52%]"></div>
                <div class="flex-1 rounded-t-sm bg-border h-[38%]"></div>
                <div class="flex-1 rounded-t-sm bg-primary/35 h-[68%]"></div>
                <div class="flex-1 rounded-t-sm bg-border h-[48%]"></div>
                <div class="flex-1 rounded-t-sm bg-primary h-[92%]"></div>
                <div class="flex-1 rounded-t-sm bg-primary/35 h-[72%]"></div>
              </div>
            </div>
            <div class="bg-light rounded-lg p-2.5">
              <div class="text-[0.58rem] font-bold text-gray uppercase tracking-wider mb-2">Últimas ventas</div>
              <div class="flex justify-between items-center py-1 border-b border-border">
                <span class="text-[0.6rem] text-gray">F001-000123</span>
                <span class="text-[0.66rem] font-bold text-primary">S/ 120.00</span>
              </div>
              <div class="flex justify-between items-center py-1 border-b border-border">
                <span class="text-[0.6rem] text-gray">B001-000466</span>
                <span class="text-[0.66rem] font-bold text-primary">S/ 150.00</span>
              </div>
              <div class="flex justify-between items-center py-1 border-b border-border">
                <span class="text-[0.6rem] text-gray">F001-000121</span>
                <span class="text-[0.66rem] font-bold text-primary">S/ 210.00</span>
              </div>
              <div class="flex justify-between items-center py-1">
                <span class="text-[0.6rem] text-gray">F001-000120</span>
                <span class="text-[0.66rem] font-bold text-primary">S/ 95.00</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="absolute -bottom-3 right-4 bg-white border border-border rounded-full px-4 py-2 text-xs font-bold text-primary shadow-[0_8px_28px_rgba(0,0,0,0.09)] flex items-center gap-1.5">
        ✅ SUNAT · Facturación electrónica
      </div>
    </div>
  </div>
</section>