---
const modules = [
  {
    icon: `<path d="M4 2v20h16V2H4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><line x1="8" y1="7" x2="16" y2="7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="8" y1="11" x2="16" y2="11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="8" y1="15" x2="12" y2="15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
    title: 'Facturación Electrónica',
    desc: 'Integración directa SUNAT, boletas, facturas y notas de crédito. 100% automático.',
  },
  {
    icon: `<circle cx="8" cy="21" r="1" fill="currentColor" stroke="none"/><circle cx="19" cy="21" r="1" fill="currentColor" stroke="none"/><path d="M2 3h3l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 7H6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
    title: 'POS Rápido',
    desc: 'Menos de 3 clics por venta.',
  },
  {
    icon: `<path d="M21 8l-9-4-9 4v8l9 4 9-4V8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><line x1="12" y1="12" x2="12" y2="20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="3" y1="8" x2="12" y2="12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="21" y1="8" x2="12" y2="12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
    title: 'Inventario Inteligente',
    desc: 'Alertas de stock bajo, control por almacén y trazabilidad completa.',
  },
  {
    icon: `<rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><line x1="9" y1="3" x2="15" y2="3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="9" y1="10" x2="15" y2="10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="9" y1="14" x2="15" y2="14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="9" y1="18" x2="12" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
    title: 'Compras y Proveedores',
    desc: 'Órdenes de compra, recepción automática y control de costos.',
  },
  {
    icon: `<line x1="12" y1="2" x2="12" y2="22" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M17 6H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
    title: 'Caja y Cierres',
    desc: 'Arqueo diario, control de ingresos/egresos. Cierra en minutos.',
  },
  {
    icon: `<path d="M21 12a9 9 0 11-6.22-8.56" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 12A10 10 0 0012 2v10z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
    title: 'Dashboard Gerencial',
    desc: 'KPIs visuales: utilidad, rotación, ticket promedio. Decisiones con datos.',
  },
  {
    icon: `<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="7" r="4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M23 21v-2a4 4 0 00-3-3.87" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 3.13a4 4 0 010 7.75" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
    title: 'Multiusuario y Roles',
    desc: 'Acceso segmentado para cajeros, administradores y dueños.',
  },
  {
    icon: `<path d="M20 2v20M4 2v20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><line x1="4" y1="8" x2="20" y2="8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="4" y1="16" x2="20" y2="16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
    title: 'Módulo Restaurante',
    desc: 'Comandas digitales, gestión de mesas y pantalla de cocina en tiempo real.',
  },
  {
    icon: `<polyline points="16 18 22 12 16 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><polyline points="8 6 2 12 8 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
    title: 'Desarrollo a Medida',
    desc: 'ERPs personalizados, integraciones API y dashboards avanzados para tu negocio.',
  },
];
---

<section class="py-20 md:py-24 bg-light relative overflow-hidden" id="modulos">
  <div
    class="absolute top-0 right-0 w-[350px] h-[350px] bg-[radial-gradient(circle,rgba(0,166,80,0.05)_0%,transparent_70%)] rounded-full translate-x-1/3 -translate-y-1/3 pointer-events-none"
  ></div>
  <div
    class="absolute bottom-0 left-0 w-[350px] h-[350px] bg-[radial-gradient(circle,rgba(0,166,80,0.03)_0%,transparent_70%)] rounded-full -translate-x-1/3 translate-y-1/3 pointer-events-none"
  ></div>

  <div class="max-w-[1180px] mx-auto px-6 relative">
    <span
      class="block text-center text-xs font-bold tracking-[0.16em] uppercase text-primary/60 mb-3"
      data-animate="fade-up"
    >
      Plataforma completa
    </span>
    <h2
      class="text-center font-extrabold text-[clamp(1.8rem,3.5vw,2.5rem)] leading-tight mb-3 text-dark2"
      data-animate="fade-up"
    >
      Todo lo que necesitas<br />en un solo lugar
    </h2>
    <p
      class="text-center text-gray text-base max-w-[560px] mx-auto mb-12 leading-relaxed"
      data-animate="fade-up"
    >
      Módulos diseñados para trabajar juntos y darte control total de tu negocio.
    </p>

    <div data-animate="stagger" data-stagger-target=".mod-card">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          modules.map((m) => (
            <div
              class="mod-card group bg-white rounded-2xl p-5 border border-border
                     shadow-[0_1px_3px_rgba(0,0,0,0.03),0_4px_12px_rgba(0,0,0,0.02)]
                     transition-all duration-300 ease-out
                     hover:-translate-y-1.5 hover:shadow-[0_8px_28px_rgba(0,0,0,0.08),0_0_0_1px_rgba(0,166,80,0.10)]
                     relative overflow-hidden"
            >
              <div
                class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-primary-light via-primary to-primary-dark
                       origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out"
              ></div>

              <div
                class="w-10 h-10 rounded-xl bg-primary-light flex items-center justify-center mb-3.5
                       transition-all duration-300 group-hover:scale-105 group-hover:shadow-[0_0_0_4px_rgba(0,166,80,0.10)]"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="w-[20px] h-[20px] text-primary"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={m.icon}
                />
              </div>

              <h3 class="text-[0.95rem] font-bold text-dark2 mb-1.5 leading-snug">
                {m.title}
              </h3>

              <p class="text-[0.84rem] text-gray leading-relaxed">
                {m.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
