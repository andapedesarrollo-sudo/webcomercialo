---

<Layout title={`${solution.title} | Comercialo`} description={solution.extendedDesc}>
  <PromoBanner />
  <Header />

  <section class={`relative overflow-hidden ${solution.bg}`}>
    <div class={`absolute inset-0 pattern-${solution.pattern}`}></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(255,255,255,0.12)_0%,_transparent_60%)]"></div>
    <div class="absolute inset-0 noise-texture"></div>
    
    <div class="relative max-w-[1180px] mx-auto px-6 py-24 md:py-12">
      <a href="/#soluciones" class="inline-flex items-center gap-1.5 text-sm text-white/80 hover:text-white transition-all duration-200 mb-6 no-underline cursor-pointer group" data-animate="fade-up">
        <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Volver a soluciones
      </a>

      <div class="max-w-[750px]" data-animate="fade-up">
        <span class="badge-pro">{solution.badge}</span>
        
        <div class="mb-6">
          <svg 
            class="w-16 h-16 md:w-20 md:h-20 text-white drop-shadow-lg" 
            fill="none" 
            stroke="currentColor" 
            viewBox="0 0 24 24" 
            stroke-width="1.5"
            aria-hidden="true"
          >
            <g set:html={heroIcons[solution.heroIcon] || heroIcons.shoppingBag} />
          </svg>
        </div>
        
        <h1 class="text-[clamp(2.5rem,6vw,4rem)] font-extrabold text-white mb-6 leading-[1.1] drop-shadow-lg">
          {solution.title}
        </h1>
        
        <p class="text-white/90 text-lg md:text-xl leading-relaxed mb-10 max-w-[620px] drop-shadow">
          {solution.extendedDesc}
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <a 
            href="/#demo" 
            data-magnetic="0.3" 
            class="btn-primary-pro bg-white text-dark2 hover:bg-gray-50 no-underline"
          >
            Prueba gratis por 15 días
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a 
            href="/#demo" 
            class="btn-secondary-pro no-underline"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Ver demo en vivo
          </a>
        </div>
        
        <div class="flex flex-wrap items-center gap-4 mt-8">
          <span class="trust-badge">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Sin tarjeta de crédito
          </span>
          <span class="trust-badge">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Implementación en 48h
          </span>
          <span class="trust-badge">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Cumplimiento SUNAT
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pro bg-light">
    <div class="max-w-[1180px] mx-auto">
      <div class="text-center mb-14" data-animate="fade-up">
        <span class="block text-xs font-bold tracking-[0.14em] uppercase mb-3" style={`color: ${solution.accentColor};`}>Funcionalidades</span>
        <h2 class="font-bold text-[clamp(1.8rem,3.5vw,2.5rem)] text-dark2 leading-tight">Todo lo que necesitas para tu negocio</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-animate="stagger" data-stagger-target=".feature-card-pro">
        {solution.features.map((feature) => (
          <div 
            class="feature-card-pro" 
            style={`--feature-accent: ${solution.accentColor}; --feature-accent-secondary: ${solution.accentColor}80;`}
          >
            <div 
              class="w-14 h-14 rounded-xl flex items-center justify-center mb-6 transition-all duration-300"
              style={`background: ${solution.accentColor}15;`}
            >
              <svg 
                class="w-7 h-7" 
                fill="none" 
                stroke={solution.accentColor} 
                viewBox="0 0 24 24" 
                stroke-width="1.5" 
                stroke-linecap="round" 
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={featureIcons[feature.icon] || featureIcons.box} 
              />
            </div>
            <h3 class="font-bold text-dark2 text-[1.1rem] mb-3">{feature.title}</h3>
            <p class="text-gray text-[0.95rem] leading-relaxed">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pro bg-white">
    <div class="max-w-[1180px] mx-auto">
