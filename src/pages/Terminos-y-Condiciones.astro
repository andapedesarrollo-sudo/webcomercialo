---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=3600');

const siteUrl = 'https://comercialo.pe';
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;
const title = 'Términos y Condiciones de Uso | Comercialo';
const description = 'Términos y condiciones que regulan el uso de Comercialo, plataforma de gestión comercial para negocios que venden productos o servicios, operada por GEN AI LEGAL S.A.C.S.';
const lastUpdated = '3 de agosto de 2026';

const termsSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${currentUrl}#webpage`,
  name: title,
  description,
  url: currentUrl,
  inLanguage: 'es-PE',
  dateModified: '2026-08-03',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Términos y Condiciones', item: currentUrl }
    ]
  },
  mainEntity: {
    '@type': 'TermsOfService',
    name: 'Términos y Condiciones de Uso de Comercialo',
    dateModified: '2026-08-03',
    serviceType: 'Plataforma de gestión comercial para comercios en general',
    provider: {
      '@type': 'Organization',
      name: 'GEN AI LEGAL S.A.C.S.',
      taxID: '20614276534',
      email: 'contacto@comercialo.pe',
      telephone: '+51 935 289 770'
    }
  }
};
---

<Layout title={title} description={description} pageSchema={termsSchema}>
  <div class="min-h-[calc(100vh-112px)] flex flex-col">
    <main class="flex-grow pt-12 lg:pt-16 pb-16 bg-background transition-colors duration-300" aria-labelledby="terms-heading">
      <div class="container mx-auto px-4 max-w-5xl relative z-10">
        <article class="bg-card border border-border shadow-card-hover rounded-3xl p-6 md:p-12">
          <header class="mb-10 border-b border-border pb-8 text-center md:text-left">
            <p class="text-xs font-bold text-[#00AD55] uppercase tracking-[0.2em] mb-3">Documento legal</p>
            <h1 id="terms-heading" class="font-display text-3xl md:text-5xl font-extrabold text-foreground mb-4 uppercase tracking-tight">
              Términos y <span class="text-[#00AD55]">Condiciones de Uso</span>
            </h1>
            <h2 class="text-lg md:text-xl font-bold text-foreground mb-3 italic opacity-90">Comercialo - GEN AI LEGAL S.A.C.S.</h2>
            <p class="text-xs font-bold text-[#00AD55] uppercase tracking-widest">Versión vigente desde: {lastUpdated}</p>
          </header>

          <nav aria-label="Índice de cláusulas" class="mb-12 rounded-2xl border border-border bg-background/60 p-5 md:p-6">
            <p class="font-bold text-foreground mb-4">Contenido</p>
            <ol class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-2 text-sm text-muted-foreground">
              {Array.from({ length: 20 }, (_, i) => i + 1).map((n) => (
                <li><a href={`#clausula-${n}`} class="hover:text-[#00AD55] transition-colors">Cláusula {n}</a></li>
              ))}
            </ol>
          </nav>

          <div class="space-y-8">
<h2 class="text-xl md:text-2xl font-bold text-foreground pt-2">Identificación del Proveedor</h2>
<p class="text-muted-foreground leading-relaxed text-sm md:text-base text-justify">La presente plataforma es operada por:</p>
<ul class="space-y-2.5 text-muted-foreground">
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Razón social: GEN AI LEGAL S.A.C.S.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>RUC: 20614276534</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Marca comercial: Comercialo (en adelante, “el Software” o “la Plataforma”)</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Domicilio fiscal: Av. Enrique López Albújar Mza. J Lote 2, Amarilis, Huánuco, Perú</span></li>
<!--email_off--><li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Correo de soporte: <a href="mailto:contacto@comercialo.pe" class="font-semibold text-[#00AD55] hover:underline">contacto@comercialo.pe</a></span></li><!--/email_off-->
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>WhatsApp: +51 935 289 770</span></li>
</ul>
<h2 class="text-xl md:text-2xl font-bold text-foreground pt-2">Naturaleza del documento</h2>
<p class="text-muted-foreground leading-relaxed text-sm md:text-base text-justify">Este documento constituye el Acuerdo de adhesión que regula el uso del Software Comercialo, marca comercial registrada y operada por GEN AI LEGAL S.A.C.S. (en adelante, “el Proveedor”). Al registrarse o utilizar el Software, la persona contratante (en adelante, “el Cliente”), por sí o en representación de la persona jurídica que contrata, declara haber leído, comprendido y aceptado íntegramente las disposiciones aquí contenidas. Estos Términos y Condiciones, conjuntamente con la Política de Privacidad y el Contrato comercial específico que se suscriba entre las partes, conforman la totalidad del acuerdo aplicable a la prestación del Software. Si el Cliente no está conforme con cualquier disposición del presente documento, debe abstenerse de instalar, registrarse o utilizar el Software.</p>
<section id="clausula-1" class="scroll-mt-28 group">
  <h2 class="text-xl md:text-2xl font-bold mb-5 text-foreground flex items-start gap-3 transition-colors group-hover:text-[#00AD55]">
    <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-[#00AD55]/10 text-[#00AD55] text-sm font-mono shrink-0">1</span>
    <span>Glosario aplicable</span>
  </h2>
  <div class="md:pl-12 md:border-l-2 border-border group-hover:border-[#00AD55]/30 transition-colors space-y-4">
<p class="text-muted-foreground leading-relaxed text-sm md:text-base text-justify">Para la correcta interpretación del presente Acuerdo, los términos que se utilicen con su primera letra en mayúscula tendrán el significado que a continuación se les asigna. Las definiciones en singular incluyen el plural y viceversa, salvo que del contexto se desprenda lo contrario:</p>
<ul class="space-y-2.5 text-muted-foreground">
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Acuerdo: el presente documento de Términos y Condiciones, junto con sus actualizaciones futuras.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Cliente: persona natural con negocio o persona jurídica que contrata el Software para apoyar la gestión de una actividad comercial de venta de productos o prestación de servicios, sea bajo modalidad mensual o anual.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Contrato comercial: el contrato escrito o digital que el Cliente suscribe con el Proveedor para la contratación específica del Software, donde se detallan plan, importe, vigencia, hardware adicional y condiciones particulares.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Consumidor final: la persona natural que adquiere productos o servicios del Cliente y a quien se le emite el comprobante electrónico generado por el Software.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Comprobante electrónico: documento tributario digital (factura, boleta, nota de crédito, nota de débito, guía de remisión, comunicación de baja) emitido conforme a la normativa de SUNAT.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Datos del Cliente: toda la información que el Cliente registra, carga, ingresa o gestiona dentro del Software, incluyendo datos de su empresa, trabajadores, consumidores finales, proveedores, productos, servicios, precios, existencias, transacciones y configuraciones tributarias.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Datos personales: toda información sobre una persona natural que la identifica o la hace identificable.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Negocio o establecimiento: el espacio físico o virtual en el que el Cliente desarrolla actividades de comercialización de productos o prestación de servicios, cualquiera sea su especialidad o tamaño.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Servicios de Terceros: servicios complementarios proporcionados por terceros independientes que se integran o vinculan al Software, tales como Operadores de Servicios Electrónicos (OSE), pasarelas de pagos, servicios de mensajería, infraestructura en la nube u otros.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Sistema contable: software, hoja de cálculo o registro independiente del Software donde el Cliente o su contador registra los asientos, libros y reportes contables exigidos por la normativa tributaria.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Proveedor: GEN AI LEGAL S.A.C.S., titular del Software Comercialo.</span></li>
</ul>
  </div>
</section>
<section id="clausula-2" class="scroll-mt-28 group">
  <h2 class="text-xl md:text-2xl font-bold mb-5 text-foreground flex items-start gap-3 transition-colors group-hover:text-[#00AD55]">
    <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-[#00AD55]/10 text-[#00AD55] text-sm font-mono shrink-0">2</span>
    <span>Naturaleza y alcance del Software</span>
  </h2>
  <div class="md:pl-12 md:border-l-2 border-border group-hover:border-[#00AD55]/30 transition-colors space-y-4">
<h3 class="text-lg font-bold text-foreground pt-2"><span class="text-[#00AD55] mr-2">2.1.</span>Qué es Comercialo</h3>
<p class="text-muted-foreground leading-relaxed text-sm md:text-base text-justify">Comercialo es una plataforma tecnológica de gestión comercial dirigida a comercios en general, emprendimientos y empresas que venden productos o prestan servicios. Permite organizar operaciones de venta, facturación electrónica, clientes, inventarios, caja, créditos, compras, proveedores y reportes, de acuerdo con el plan contratado y las funciones habilitadas. Sus principales módulos son:</p>
<ul class="space-y-2.5 text-muted-foreground">
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span><strong>Gestión de Ventas y Facturación (CPE SUNAT):</strong> Punto de venta (POS) para la comercialización de productos, servicios y conceptos. Permite la emisión y envío a SUNAT de comprobantes electrónicos (facturas, boletas, notas de crédito y notas de débito), así como el monitoreo del estado de dichos documentos.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span><strong>Gestión Comercial y de Clientes:</strong> Registro y clasificación de clientes, seguimiento de operaciones comerciales, elaboración de cotizaciones y administración de catálogos de productos o servicios.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span><strong>Control de Inventario y Almacenes:</strong> Administración integral del catálogo (productos, servicios, categorías, marcas, grupos y subgrupos). Incluye el registro de movimientos de inventario (ingresos, salidas y traspasos entre almacenes) para un control exacto del stock.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span><strong>Gestión Financiera de Caja y Créditos:</strong> Administración del flujo de caja por cajero (aperturas, cierres, historial y movimientos de dinero), así como el seguimiento de Cuentas por Cobrar (reportes de deuda y cobranzas) y Cuentas por Pagar.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span><strong>Gestión de Compras:</strong> Registro de adquisiciones, control de gastos asociados y administración del directorio de proveedores.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span><strong>Guías de Remisión Electrónica:</strong> Emisión de guías de remisión para el despacho de mercadería, incluyendo el registro de transportistas, conductores y vehículos.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span><strong>Reportes Gerenciales y Configuraciones:</strong> Generación de métricas de negocio (ingresos, salidas, compras, ventas, utilidades, inventario físico y reportes operativos), además de la gestión de roles de usuarios y la configuración general del negocio.</span></li>
</ul>
<h3 class="text-lg font-bold text-foreground pt-2"><span class="text-[#00AD55] mr-2">2.2.</span>Lo que el Software no es</h3>
<p class="text-muted-foreground leading-relaxed text-sm md:text-base text-justify">Para evitar interpretaciones erróneas sobre el alcance funcional, el Cliente reconoce y acepta expresamente que Comercialo:</p>
<ul class="space-y-2.5 text-muted-foreground">
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span><strong>No es un sistema de contabilidad.</strong> Aunque provee un reporte denominado “Contabilidad Estándar”, no genera asientos contables, no produce libros contables ni registros electrónicos oficiales en los términos exigidos por la normativa tributaria vigente, no aplica las dinámicas del Plan Contable General Empresarial ni elabora estados financieros definitivos.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span><strong>No reemplaza al contador.</strong> El Cliente conserva la obligación indelegable de contratar y mantener un contador colegiado, así como un sistema contable independiente (o el mecanismo que el Cliente considere) para la correcta liquidación de sus impuestos.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span><strong>No emite opiniones tributarias, financieras ni legales.</strong> La data y los reportes que el Software genera son herramientas e insumos operativos para facilitar la administración del negocio.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span><strong>No constituye un servicio integral de cumplimiento tributario.</strong> La correcta determinación, declaración y pago de tributos ante la SUNAT son responsabilidades exclusivas del Cliente.</span></li>
</ul>
<h3 class="text-lg font-bold text-foreground pt-2"><span class="text-[#00AD55] mr-2">2.3.</span>Software entregado “tal cual”</h3>
<p class="text-muted-foreground leading-relaxed text-sm md:text-base text-justify">El Software se proporciona en el estado en que se encuentra. El Proveedor realiza esfuerzos razonables para que las funcionalidades cumplan con su propósito, pero no garantiza que: (i) la operación sea ininterrumpida o libre de errores, (ii) las funcionalidades cubran todas las necesidades particulares del Cliente, (iii) los reportes operativos sean completamente exactos en todos los escenarios, (iv) las funcionalidades existentes se mantengan permanentemente disponibles. Con la evolución del producto, algunas funcionalidades podrán incorporarse, modificarse o retirarse.</p>
  </div>
</section>
<section id="clausula-3" class="scroll-mt-28 group">
  <h2 class="text-xl md:text-2xl font-bold mb-5 text-foreground flex items-start gap-3 transition-colors group-hover:text-[#00AD55]">
    <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-[#00AD55]/10 text-[#00AD55] text-sm font-mono shrink-0">3</span>
    <span>Sistema de Control Operativo no Contable</span>
  </h2>
  <div class="md:pl-12 md:border-l-2 border-border group-hover:border-[#00AD55]/30 transition-colors space-y-4">
<p class="text-muted-foreground leading-relaxed text-sm md:text-base text-justify">Esta cláusula es de aceptación expresa por parte del Cliente y constituye condición esencial para la contratación del Software.</p>
<h3 class="text-lg font-bold text-foreground pt-2"><span class="text-[#00AD55] mr-2">3.1.</span>Marco normativo aplicable</h3>
<p class="text-muted-foreground leading-relaxed text-sm md:text-base text-justify">El numeral 5 del artículo 87 del Texto Único Ordenado del Código Tributario, modificado por el Decreto Legislativo N° 1523, y el numeral 13.1 del artículo 13 del Decreto Supremo N° 303-2025-EF, establecen la obligación del deudor tributario de proporcionar a la SUNAT los perfiles de acceso al “sistema de procesamiento electrónico de datos con el que dicho deudor tributario registra sus operaciones contables”, siempre que el referido sistema cuente con tal opción.</p>
<h3 class="text-lg font-bold text-foreground pt-2"><span class="text-[#00AD55] mr-2">3.2.</span>Comercialo no califica como sistema contable</h3>
<p class="text-muted-foreground leading-relaxed text-sm md:text-base text-justify">El Cliente declara conocer y aceptar que Comercialo no califica como un sistema de procesamiento electrónico de datos con el que el deudor tributario registra sus operaciones contables, dado que:</p>
<ul class="space-y-2.5 text-muted-foreground">
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>No genera asientos contables ni libros contables electrónicos.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>No aplica las dinámicas contables del Plan Contable General Empresarial.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>No produce los reportes contables exigidos por la normativa tributaria.</span></li>
<li class="flex gap-3 leading-relaxed text-sm md:text-base"><span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-[#00AD55] shrink-0"></span><span>Sus funcionalidades se limitan al control operativo del establecimiento (facturación, kardex, caja, ventas y gastos), las cuales son distintas y previas al registro contable propiamente dicho que se realiza en el sistema contable del cliente.</span></li>
</ul>
<h3 class="text-lg font-bold text-foreground pt-2"><span class="text-[#00AD55] mr-2">3.3.</span>Sistema contable independiente del Cliente</h3>
<p class="text-muted-foreground leading-relaxed text-sm md:text-base text-justify">El Cliente declara expresamente que cuenta con un sistema contable propio y separado del Software (sea un software contable propio, contratado a un tercero, llevado por su contador externo o cualquier otro medio admitido por la normativa), donde efectivamente registra sus operaciones contables. Es ese sistema contable —y no Comercialo— el que constituye el “sistema de procesamiento electrónico de datos” al que se refiere el numeral 5 del artículo 87 del Código Tributario y el artículo 13 del Decreto Supremo N° 303-2025-EF. Importante: El Cliente exime expresamente al Proveedor de la obligación de habilitar accesos directos de SUNAT al Software. El Cliente, en su condición de contribuyente, asume íntegramente la responsabilidad de atender los requerimientos tributarios mediante su propio sistema contable y mediante la entrega de los reportes operativos que Comercialo le permite generar.</p>
<h3 class="text-lg font-bold text-foreground pt-2"><span class="text-[#00AD55] mr-2">3.4.</span>Cooperación operativa frente a requerimientos</h3>
<p class="text-muted-foreground leading-relaxed text-sm md:text-base text-justify">Sin perjuicio de lo anterior, ante un requerimiento de SUNAT que involucre información contenida en el Software, el Proveedor brindará al Cliente, sin costo adicional, soporte razonable para generar y descargar los reportes operativos disponibles, exportar los XML y PDF de los comprobantes electrónicos, y entregar al Cliente la información que este, por sí mismo, pueda transmitir a SUNAT. Los servicios de soporte adicionales (consultoría tributaria, acompañamiento en fiscalización, integraciones especiales) se rigen por presupuestos separados.</p>
  </div>
</section>
<section id="clausula-4" class="scroll-mt-28 group">
  <h2 class="text-xl md:text-2xl font-bold mb-5 text-foreground flex items-start gap-3 transition-colors group-hover:text-[#00AD55]">
    <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-[#00AD55]/10 text-[#00AD55] text-sm font-mono shrink-0">4</span>
    <span>Responsabilidad exclusiva del Cliente sobre los datos cargados</span>
  </h2>
  <div class="md:pl-12 md:border-l-2 border-border group-hover:border-[#00AD55]/30 transition-colors space-y-4">
<h3 class="text-lg font-bold text-foreground pt-2"><span class="text-[#00AD55] mr-2">4.1.</span>Principio general</h3>
<p class="text-muted-foreground leading-relaxed text-sm md:text-base text-justify">El Cliente es el único responsable, frente a terceros y frente a las autoridades, de toda la información que registra, carga, ingresa, modifica o elimina dentro del Software. El Proveedor actúa únicamente como intermediario tecnológico que brinda la infraestructura, sin intervenir en la veracidad, exactitud, oportunidad o legalidad de los datos que el Cliente decida ingresar.</p>
<h3 class="text-lg font-bold text-foreground pt-2"><span class="text-[#00AD55] mr-2">4.2.</span>Garantía de veracidad</h3>
